generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}

model Settings {
    idGuild String
    key     String
    value   String @db.Text

    @@id([idGuild, key])
    @@map("settings")
}

model UserPreference {
    idUser String
    locale String

    @@id(idUser)
    @@map("user_preference")
}

model Language {
    id      Int    @default(autoincrement())
    enName  String
    frName  String
    idGuild String
    idRole  String

    aliases LanguageAlias[]

    @@id(id)
    @@unique(idRole)
    @@index(enName)
    @@index(frName)
    @@index(idGuild)
    @@index(idRole)
    @@map("language")
}

model LanguageAlias {
    id         Int    @default(autoincrement())
    idLanguage Int
    alias      String

    language Language @relation(fields: [idLanguage], references: [id], onDelete: Cascade)

    @@id(id)
    @@index(alias)
    @@map("language_alias")
}

model Country {
    id      Int    @default(autoincrement())
    enName  String
    frName  String
    idGuild String
    idRole  String

    aliases CountryAlias[]

    @@id(id)
    @@unique(idRole)
    @@index(enName)
    @@index(frName)
    @@index(idGuild)
    @@index(idRole)
    @@map("country")
}

model CountryAlias {
    id        Int    @default(autoincrement())
    idCountry Int
    alias     String

    country Country @relation(fields: [idCountry], references: [id], onDelete: Cascade)

    @@id(id)
    @@index(alias)
    @@map("country_alias")
}

model Topic {
    id        Int    @default(autoincrement())
    locale    String @db.VarChar(10)
    text      String @db.Text
    postCount Int    @default(0)

    @@id(id)
    @@index([locale, postCount])
    @@map("topic")
}
